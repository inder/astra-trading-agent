{
  "name": "astra-trading-agent",
  "version": "0.3.1",
  "private": true,
  "description": "Astra Trading Agent for Robinhood: self-hosted, paper-first MCP strategy framework",
  "type": "module",
  "engines": { "node": ">=24" },
  "bin": { "astra-trading-agent": "src/agent-server.ts" },
  "scripts": {
    "start": "node src/agent-server.ts",
    "demo": "node src/demo.ts",
    "connect": "node src/connect.ts",
    "setup": "node src/setup.ts",
    "install-agent": "node src/install-agent.ts",
    "replay": "node src/replay.ts",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node --test test/e2e/*.e2e.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "files": ["src/", "README.md", "INSTALL.md", "AGENTS.md", "CLAUDE.md", "SECURITY.md", "docs/", "LICENSE"],
  "dependencies": { "@modelcontextprotocol/sdk": "1.30.0", "zod": "3.25.76" },
  "devDependencies": { "@types/node": "24.3.0", "playwright-core": "1.63.0", "typescript": "5.9.2" }
}
